<IfModule mod_rewrite.c>
    RewriteEngine On

    # ------------------------------------------------------------------
    # SPA fallback: serve index.html for client-side routes
    # (/register, /banking, /forgot-password, ...) so hard reloads and
    # deep links don't return a 404.
    # ------------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>

# ------------------------------------------------------------------
# Caching
# ------------------------------------------------------------------
<IfModule mod_headers.c>
    # Never cache index.html — it must always reference the latest hashed assets.
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Hashed assets (filenames contain content hashes) can be cached forever.
    <FilesMatch "\.(js|css|png|jpe?g|gif|svg|webp|ico|woff2?|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

